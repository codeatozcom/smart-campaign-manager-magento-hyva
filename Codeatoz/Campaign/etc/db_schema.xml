<?xml version="1.0"?>
<schema xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:Setup/Declaration/Schema/etc/schema.xsd">
    <table name="codeatoz_campaign" resource="default" engine="innodb" comment="Codeatoz Campaign Table">
        <column xsi:type="int" name="campaign_id" unsigned="true" nullable="false" identity="true" comment="Campaign ID"/>
        <column xsi:type="varchar" name="name" nullable="false" length="255" comment="Campaign Name"/>
        <column xsi:type="varchar" name="campaign_type" nullable="false" length="50" default="general" comment="Campaign Type"/>
        <column xsi:type="smallint" name="status" nullable="false" default="0" unsigned="true" comment="Status (0=Draft,1=Scheduled,2=Active,3=Expired)"/>
        <column xsi:type="datetime" name="start_date" nullable="false" comment="Start Date"/>
        <column xsi:type="datetime" name="end_date" nullable="false" comment="End Date"/>
        <column xsi:type="smallint" name="priority" nullable="false" default="0" comment="Priority"/>
        <column xsi:type="text" name="config_json" nullable="true" comment="Visual Configuration JSON"/>
        <column xsi:type="text" name="store_ids" nullable="true" comment="Store IDs JSON Array"/>
        <column xsi:type="timestamp" name="created_at" nullable="false" default="CURRENT_TIMESTAMP" comment="Created At"/>
        <column xsi:type="timestamp" name="updated_at" nullable="false" default="CURRENT_TIMESTAMP" on_update="true" comment="Updated At"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="campaign_id"/>
        </constraint>
        <index referenceId="CODEATOZ_CAMPAIGN_STATUS" indexType="btree">
            <column name="status"/>
        </index>
        <index referenceId="CODEATOZ_CAMPAIGN_START_DATE" indexType="btree">
            <column name="start_date"/>
        </index>
        <index referenceId="CODEATOZ_CAMPAIGN_END_DATE" indexType="btree">
            <column name="end_date"/>
        </index>
        <index referenceId="CODEATOZ_CAMPAIGN_STATUS_START_END" indexType="btree">
            <column name="status"/>
            <column name="start_date"/>
            <column name="end_date"/>
        </index>
    </table>
</schema>
