<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:Acl/etc/acl.xsd">
    <acl>
        <resources>
            <resource id="Magento_Backend::admin">
                <resource id="Magento_Backend::marketing">
                    <resource id="Codeatoz_Campaign::campaign"
                              title="Smart Campaigns"
                              sortOrder="100">
                        <resource id="Codeatoz_Campaign::campaign_manage"
                                  title="Manage Campaigns (Create, Edit, Delete)"
                                  sortOrder="10"/>
                        <resource id="Codeatoz_Campaign::campaign_view"
                                  title="View Campaigns"
                                  sortOrder="20"/>
                    </resource>
                </resource>
            </resource>
        </resources>
    </acl>
</config>
